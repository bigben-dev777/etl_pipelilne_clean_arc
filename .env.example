# =======================================
#    ENV EXAMPLE
# =======================================


# LLM Provider (optional, for AI features)
OPENAI_API_KEY=your_key_here
LLM_PROVIDER=openai
LLM_MODEL_CLASSIFICATION=gpt-4o-mini
LLM_MODEL_RESOLUTION=gpt-4o

# Database
DATABASE_URL=sqlite:///./data/processed/leads.db

# Processing
BATCH_SIZE=100
MAX_WORKERS=4

# Logging
LOG_LEVEL=INFO
